# Sao chép file này thành .env rồi điền API key của bạn.
# Lấy key miễn phí tại: https://www.weatherapi.com/
VITE_WEATHER_API_KEY=your_api_key_here

# Cấu hình Supabase Auth — tạo project tại https://supabase.com
# rồi lấy giá trị trong Settings -> API. Nhớ tắt "Confirm email" (Authentication -> Providers -> Email).
VITE_SUPABASE_URL=your_supabase_project_url
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key
